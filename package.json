{
  "name": "jeko",
  "version": "0.1.0",
  "private": true,
  "description": "Jeko: tool di SDLC locale e personale",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/runner",
    "packages/admin"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run && npm test -w @jeko/admin",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:server": "npm run dev -w @jeko/server",
    "dev:runner": "npm run dev -w @jeko/runner",
    "dev:admin": "npm start -w @jeko/admin"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "angular-eslint": "^22.8.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
