# Cartella dei dati (file JSON e cartelle delle run): di default %LOCALAPPDATA%\jeko\data.
# JEKO_DATA_DIR=
# Cartella del runner (giornali delle run e turni di claude): di default %LOCALAPPDATA%\jeko\runner.
# JEKO_RUNNER_DATA=
# Porta del servizio (solo su 127.0.0.1).
JEKO_PORT=4310
# Comando di Claude Code, se non è "claude" nel PATH.
# JEKO_CLAUDE_BIN=
# Repository GitHub delle release, per gli aggiornamenti dell'app desktop.
# JEKO_UPDATE_REPO=leolmi/jeko
